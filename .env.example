# =============================================================
# AI DROPSHIPPING PLATFORM — ENVIRONMENT CONFIGURATION
# =============================================================
# Copy this file to .env and fill in your real credentials.

# ---- ANTHROPIC (Claude AI) -----------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---- DATABASE ------------------------------------------------
DATABASE_URL=postgresql+asyncpg://dropship:dropship_pass@db:5432/dropship_db
REDIS_URL=redis://redis:6379/0

# ---- CJDROPSHIPPING SUPPLIER API ----------------------------
# Sign up at: https://developers.cjdropshipping.com/
CJ_API_KEY=your_cjdropshipping_api_key_here
CJ_ACCESS_TOKEN=your_cjdropshipping_access_token_here

# ---- STRIPE PAYMENTS ----------------------------------------
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ---- STORE CONFIGURATION ------------------------------------
STORE_NAME=TechFlow
STORE_DOMAIN=https://your-store-domain.com
STORE_CURRENCY=USD
STORE_EMAIL=support@your-store-domain.com

# ---- PROFIT MARGINS -----------------------------------------
# Minimum markup over supplier cost (multiplier)
MIN_PROFIT_MULTIPLIER=2.2
# Target markup
TARGET_PROFIT_MULTIPLIER=2.8
# Max price ceiling (don't price above this even if margin allows)
MAX_PRODUCT_PRICE=299.00

# ---- AUTOMATION INTERVALS (in hours) ------------------------
PRODUCT_DISCOVERY_INTERVAL_HOURS=24
PRICE_UPDATE_INTERVAL_HOURS=6
INVENTORY_SYNC_INTERVAL_HOURS=2
SECURITY_SCAN_INTERVAL_HOURS=12
ANALYTICS_REPORT_INTERVAL_HOURS=24

# ---- SECURITY -----------------------------------------------
SECRET_KEY=change_this_to_a_random_64_char_string
ADMIN_EMAIL=admin@your-store-domain.com
ADMIN_PASSWORD=change_this_strong_password

# ---- NOTIFICATIONS (optional) --------------------------------
# Slack webhook for AI agent alerts
SLACK_WEBHOOK_URL=

# SendGrid for order confirmation emails
SENDGRID_API_KEY=

# ---- ENVIRONMENT --------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
